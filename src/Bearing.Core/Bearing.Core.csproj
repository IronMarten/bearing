<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The analysis half: workspace load, walkers, the structure model, graph algorithms,
    classification. See docs/ARCHITECTURE.md.

    Two rules about this project are enforced by tests/Bearing.Tests/SeamTests.cs rather
    than by review, because prose did not stop it happening the first time — Report.cs
    ended up 997 lines of console formatting with the interpretation baked in:

      1. Bearing.Core must not reference System.Console.
      2. Bearing.Core must not reference Bearing.Cli.

    Not packed on its own. PackAsTool folds it into IronMarten.Bearing, and shipping a
    separate library would make its API a public contract before it has a stable shape.
  -->
  <PropertyGroup>
    <RootNamespace>IronMarten.Bearing</RootNamespace>
    <AssemblyName>Bearing.Core</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- MSBuildLocator requires that MSBuild assemblies are NOT copied local. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.12.0" />
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
  </ItemGroup>

  <!--
    Microsoft.Build.* must be resolved from the located SDK at runtime, not from our bin.
    Registering the SDK is the host's job — Bearing.Cli calls MSBuildLocator — because a
    library that registers a global singleton on load cannot be composed.
  -->
  <Target Name="RemoveMSBuildAssemblies" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Microsoft.Build'&#xA;                                       or '%(Filename)' == 'Microsoft.Build.Framework'&#xA;                                       or '%(Filename)' == 'Microsoft.Build.Tasks.Core'&#xA;                                       or '%(Filename)' == 'Microsoft.Build.Utilities.Core'" />
    </ItemGroup>
  </Target>

</Project>
