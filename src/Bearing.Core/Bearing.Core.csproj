<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The analysis half: workspace load, walkers, the structure model, graph algorithms,
    classification. See docs/ARCHITECTURE.md.

    Two rules about this project are enforced by tests/Bearing.Tests/SeamTests.cs rather
    than by review, because prose did not stop it happening the first time — Report.cs
    ended up 997 lines of console formatting with the interpretation baked in:

      1. Bearing.Core must not reference System.Console.
      2. Bearing.Core must not reference Bearing.Cli.

    Not packed on its own. PackAsTool folds it into IronMarten.Bearing, and shipping a
    separate library would make its API a public contract before it has a stable shape.
  -->
  <PropertyGroup>
    <RootNamespace>IronMarten.Bearing</RootNamespace>
    <AssemblyName>Bearing.Core</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- MSBuildLocator requires that MSBuild assemblies are NOT copied local. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.12.0" />
    <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
  </ItemGroup>

  <!--
    Microsoft.Build.* is compiled against and never shipped: what loads at runtime is the
    located SDK's MSBuild. Registering the SDK is the host's job — Bearing.Cli calls
    MSBuildLocator — because a library that registers a global singleton on load cannot be
    composed.

    These references exist because Workspaces.MSBuild asks for 17.7.2, which carries
    CVE-2025-26646. Pinning the patched 17.14 line raises the version for every project that
    references this one; ExcludeAssets keeps its runtime out of this project's output.

    ExcludeAssets does NOT flow to a referencing project, so Bearing.Cli carries the same four.
    This file used to do the exclusion with a RemoveMSBuildAssemblies target, which removed the
    assemblies from this project's output only — and IronMarten.Bearing 0.1.0 shipped all four,
    at 17.7.2, from Bearing.Cli's. Deleting them from that build changed nothing but the
    timestamp in a Jellyfin run, so they were never what loaded.

    System.Security.Cryptography.Xml is Microsoft.Build.Tasks.Core's, pinned for the same reason:
    17.14 asks for 9.0.0, which carries CVE-2026-50648 among others.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Build" Version="17.14.28" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Framework" Version="17.14.28" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="17.14.28" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" ExcludeAssets="runtime" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
  </ItemGroup>

</Project>
