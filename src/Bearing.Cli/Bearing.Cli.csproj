<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The presentation half: argument parsing, terminal output, and the report renderers.
    This is the only project that packs, and the only one allowed to touch the console.
    Shared identity and strictness come from the repo-root Directory.Build.props.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>bearing</AssemblyName>
    <RootNamespace>IronMarten.Bearing.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bearing.Core\Bearing.Core.csproj" />
  </ItemGroup>

  <!--
    Registering the MSBuild SDK is the host's job, so the locator belongs here and not in
    Bearing.Core: a library that registers a process-wide singleton on load cannot be composed.
    Core's csproj carries the other half of that decision.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
  </ItemGroup>

  <!-- dotnet tool packaging -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>bearing</ToolCommandName>
    <PackageId>IronMarten.Bearing</PackageId>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!--
    Package metadata. The NuGet ID-prefix reservation criteria check that identifying
    properties are "clear and consistent (especially the package author)", that the
    licence uses the `license` element rather than the deprecated `licenseUrl`, and
    that any icon is embedded rather than an `iconUrl`. Author, licence, and the project
    and repository URLs are set once in Directory.Build.props so every IronMarten.*
    package stays consistent without anyone remembering to copy them.
  -->
  <PropertyGroup>
    <Description>Get your bearings in a .NET codebase. Bearing reads a solution and reports a map of the system and a short list of the components that are unusual for what they are — relative to their structural peers, never as a score.</Description>
    <PackageTags>architecture;analysis;roslyn;static-analysis;dependency-graph;code-quality;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- Source-linked builds. Determinism itself is set repo-wide. -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
