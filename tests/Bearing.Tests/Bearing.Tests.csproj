<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One test project, deliberately. It references BOTH Bearing.Core and the ArchProbe
    oracle, because the central regression technique for phase 1 is running the two against
    the same fixture and diffing (oracle/README.md). Splitting them into separate projects
    would put a project boundary through the middle of that comparison.

    Common settings — TFM, nullable, analyzers, warnings-as-errors — come from the repo-root
    Directory.Build.props. Test-specific analyzer relaxations are in .editorconfig under
    [tests/**/*.cs], with reasons.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <!-- Verify drives the accept-workflow snapshots. The frozen oracle goldens are a
         different regime and are compared byte-for-byte; see docs/TESTING.md. -->
    <PackageReference Include="Verify.Xunit" Version="31.12.5" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\oracle\ArchProbe\ArchProbe.csproj" />
    <ProjectReference Include="..\..\src\Bearing.Core\Bearing.Core.csproj" />
  </ItemGroup>

  <!--
    A real reference, as of R1. It used to be ReferenceOutputAssembly=false, on the grounds that
    referencing Cli "would create the very Core -> Cli edge the test exists to forbid" — which is
    not what it creates. Every seam assertion reads Bearing.Core's csproj and Bearing.Core.dll;
    what this project references appears in neither, and SeamTests stays exactly as strong.

    What the old arrangement did cost was the renderer: with no compile-time reference nothing
    here could name a type in Cli, and R1 moves the report — and with it defects 3, 16 and 17 —
    into that assembly. A rendering layer carrying three defect fixes cannot be the one part of
    the tool no test can see.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Bearing.Cli\Bearing.Cli.csproj" />
  </ItemGroup>

</Project>
